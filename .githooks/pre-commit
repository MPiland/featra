#!/bin/sh
# The commit gate (STORY-41, ADR 0014): format check, lint, typecheck and unit tests must all pass. A commit that
# changes only cards and Markdown docs runs the smaller content gate instead (BUG-28, below).
# `pnpm install` turns it on (the prepare script sets core.hooksPath to .githooks).

# Git puts its exec-path first on PATH for hooks. On Windows the git.exe there has none of git's DLLs beside it and
# starts far slower, which pushed the server's timed tests past their waits (BUG-6). Run the gate as a shell would.
# `cd` and `pwd` spell the exec-path the way this sh spells PATH (`/mingw64/...` in Git Bash).
exec_path=$(cd "$(git --exec-path)" && pwd)
kept=
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$exec_path" ] || kept="${kept:+$kept:}$dir"
done
IFS=$old_ifs
PATH=$kept
export PATH

# Three test workers by default: with one per core a full run exhausts this PC's memory, and process creation then
# stalls for 20 s or more, failing timed tests at random (BUG-12, decisions.md). A value in the environment wins.
VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-3}
export VITEST_MAX_WORKERS

# Every unit test's time limit (tooling/hang-guard.ts): 900 s here, since a commit is often made on a loaded PC
# (BUG-28). A value in the environment wins.
FEATRA_HANG_GUARD_MS=${FEATRA_HANG_GUARD_MS:-900000}
export FEATRA_HANG_GUARD_MS

# The content gate (BUG-28, ADR 0014) is the format check and the card tests, which parse and validate every card. It
# runs when every change in the working tree, staged or not, is under `.featra/` or is Markdown at the root or in
# docs/. The rest of the gate would only repeat what the last code commit proved, at 20 to 30 minutes on a busy PC.
# A rename counts as a delete and an add, so code moved into `.featra/` is still code. Paths are printed as they are,
# not quoted, so a name with a space or an accent is read whole.
changed_paths() {
  git -c core.quotePath=false diff --cached --name-only --no-renames
  git -c core.quotePath=false diff --name-only --no-renames
  untracked_code
}

# An untracked file counts only if a test or build could load it: by its type, or by being in a package. Others, such
# as a screenshot left at the root, are not the commit's.
untracked_code() {
  git -c core.quotePath=false ls-files --others --exclude-standard | while IFS= read -r path; do
    case "$path" in
      packages/* | apps/* | tooling/*) echo "$path" ;;
      *.ts | *.tsx | *.js | *.mjs | *.cjs | *.mts | *.cts) echo "$path" ;;
      *.json | *.yaml | *.yml | *.css | *.html) echo "$path" ;;
    esac
  done
}

content_only() {
  changed=$(changed_paths | sort -u)
  [ -n "$changed" ] || return 1
  printf '%s\n' "$changed" | while IFS= read -r path; do
    case "$path" in
      .featra/* | docs/*.md) ;;
      */*) echo code ;;
      *.md) ;;
      *) echo code ;;
    esac
  done | grep -q code && return 1
  return 0
}

if content_only; then
  exec pnpm check:content
fi
exec pnpm check
