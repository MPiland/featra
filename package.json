{
  "name": "featra",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @featra/desktop start",
    "dev:client": "pnpm --filter @featra/client dev",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --testTimeout=30000",
    "test:e2e": "pnpm --filter @featra/desktop test:e2e",
    "test:e2e:wsl": "node tooling/e2e/wsl.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern \"**/lint-fixtures/**\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "prepare": "node tooling/install-hooks.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
