{
  "name": "@featra/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @featra/client build && vite build && vite build --mode preload && vite build --mode server && vite build --mode mcp",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc -p . --noEmit",
    "test:e2e": "pnpm run build && playwright test -c e2e"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@featra/client": "workspace:*",
    "@featra/mcp": "workspace:*",
    "@featra/server": "workspace:*",
    "@featra/work-format": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "~45.2.2",
    "vite": "8.3.5"
  }
}
